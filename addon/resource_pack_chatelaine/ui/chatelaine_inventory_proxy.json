          "texture": "textures/ui/pocket_ui_highlight_selected_slot",
          "anchor_from": "center",
          "anchor_to": "center",
          "visible": false
        }
      },
      {
        "slot_button@chatelaine_inventory.static_pocket_bag_slot_button": {
          "visible": false
        }
      }
