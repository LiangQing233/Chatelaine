{
  "namespace": "chatelaine_inventory",

  "item_layer@common.item_renderer_additional_layer": {
    "size": ["100%", "100%"],
    "anchor_from": "center",
    "anchor_to": "center",
    "bindings": [
      { "binding_name": "#visible", "binding_condition": "always" },
      { "binding_name": "#uv", "binding_condition": "always_when_visible" },
      { "binding_name": "#uv_size", "binding_condition": "always_when_visible" },
      { "binding_name": "#texture", "binding_condition": "always_when_visible" }
    ]
  },
  "layered_item_renderer": {
    "type": "custom",
    "renderer": "inventory_item_renderer",
    "controls": [
      {
        "top_layer_3@chatelaine_inventory.item_layer": {
          "$item_renderer_additional_layer_layer": 3
        }
      },
      {
        "top_layer_2@chatelaine_inventory.item_layer": {
          "$item_renderer_additional_layer_layer": 2
        }
      },
      {
        "top_layer_1@chatelaine_inventory.item_layer": {
          "$item_renderer_additional_layer_layer": 1
        }
      },
      {
        "bottom_layer_1@chatelaine_inventory.item_layer": {
          "$item_renderer_additional_layer_layer": -1
        }
      },
      {
        "bottom_layer_2@chatelaine_inventory.item_layer": {
          "$item_renderer_additional_layer_layer": -2
        }
      }
    ]
  },

  "replica_slot_button": {
    "type": "button",
    "size": ["100%", "100%"],
    "layer": 3,
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "focus_enabled": true,
    "focus_magnet_enabled": true,
    "is_handle_button_move_event": true,
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "$primary_button_name",
        "mapping_type": "pressed",
        "consume_event": true
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "$primary_button_name",
        "mapping_type": "pressed",
        "consume_event": true
      },
      {
        "from_button_id": "button.menu_secondary_select",
        "to_button_id": "$secondary_button_name",
        "mapping_type": "pressed",
        "consume_event": true
      },
      {
        "from_button_id": "button.menu_auto_place",
        "to_button_id": "$quick_button_name",
        "mapping_type": "pressed",
        "consume_event": true
      }
    ],
    "controls": [
      { "default": { "type": "panel", "size": ["100%", "100%"] } },
      {
        "hover": {
          "type": "panel",
          "size": ["100%", "100%"],
          "controls": [
            {
              "hover_image": {
                "type": "image",
                "size": ["100%", "100%"],
                "texture": "$hover_texture",
                "layer": 4,
                "alpha": 0.8,
                "visible": false,
                "bindings": [
                  {
                    "binding_name": "(not #using_touch)",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            },
            {
              "hover_text@common.hover_text": {
                "layer": 80,
                "visible": false,
                "$hover_text_max_width": 0,
                "bindings": [
                  {
                    "binding_name": "(not #using_touch)",
                    "binding_name_override": "#visible"
                  },
                  {
                    "binding_type": "collection",
                    "binding_collection_name": "$item_collection_name",
                    "binding_name": "#chatelaine_hover_text",
                    "binding_name_override": "#hover_text",
                    "binding_condition": "always_when_visible"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "pressed": {
          "type": "image",
          "size": ["100%", "100%"],
          "texture": "$hover_texture"
        }
      }
    ]
  },

  "replica_slot": {
    "type": "input_panel",
    "size": "$cell_size",
    "visible": false,
    "layer": 1,
    "$cell_size|default": [18, 18],
    "$item_size|default": [16, 16],
    "$durability_size|default": [12, 1],
    "$durability_offset|default": [0, 5],
    "$hover_texture|default": "textures/ui/slot_disabled_hover",
    "$selection_texture|default": "textures/ui/pocket_ui_highlight_selected_slot",
    "$selection_size|default": [23, 23],
    "$lock_badge_offset|default": [0, 0],
    "$item_collection_name|default": "chatelaine_inventory_bag",
    "$primary_button_name|default": "#chatelaine_inventory_bag_primary",
    "$secondary_button_name|default": "#chatelaine_inventory_bag_secondary",
    "$quick_button_name|default": "#chatelaine_inventory_bag_quick",
    "controls": [
      {
        "background": {
          "type": "image",
          "size": "$cell_size",
          "texture": "textures/ui/cell_image",
          "visible": false
        }
      },
      {
        "selected_background": {
          "type": "image",
          "size": "$cell_size",
          "layer": 8,
          "texture": "textures/ui/recipe_book_touch_cell_selected",
          "visible": false,
          "bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name",
              "binding_name": "#chatelaine_selected",
              "binding_name_override": "#visible",
              "binding_condition": "always"
            }
          ]
        }
      },
      {
        "item@chatelaine_inventory.layered_item_renderer": {
          "size": "$item_size",
          "layer": 12,
          "anchor_from": "center",
          "anchor_to": "center",
          "visible": false
        }
      },
      {
        "empty_icon": {
          "type": "image",
          "size": "$item_size",
          "layer": 3,
          "anchor_from": "center",
          "anchor_to": "center",
          "visible": false,
          "bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name",
              "binding_name": "#chatelaine_empty_texture",
              "binding_name_override": "#texture",
              "binding_condition": "always_when_visible"
            }
          ]
        }
      },
      {
        "stack_count": {
          "type": "label",
          "anchor_from": "bottom_right",
          "anchor_to": "bottom_right",
          "offset": [0, 1],
          "layer": 20,
          "shadow": true,
          "color": "$item_stack_count_color",
          "text": "#chatelaine_stack_text",
          "visible": false,
          "bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name",
              "binding_name": "#chatelaine_stack_visible",
              "binding_name_override": "#visible",
              "binding_condition": "always"
            },
            {
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name",
              "binding_name": "#chatelaine_stack_text",
              "binding_condition": "always_when_visible"
            }
          ]
        }
      },
      {
        "durability": {
          "type": "custom",
          "renderer": "progress_bar_renderer",
          "size": "$durability_size",
          "offset": "$durability_offset",
          "layer": 21,
          "visible": false,
          "property_bag": {
            "drop_shadow": true,
            "is_durability": true,
            "round_value": true
          },
          "bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name",
              "binding_name": "#chatelaine_durability_visible",
              "binding_name_override": "#visible",
              "binding_condition": "always"
            },
            {
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name",
              "binding_name": "#chatelaine_durability_visible",
              "binding_name_override": "#touch_progress_bar_visible",
              "binding_condition": "always"
            },
            {
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name",
              "binding_name": "#chatelaine_durability_total",
              "binding_name_override": "#progress_bar_total_amount",
              "binding_condition": "always"
            },
            {
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name",
              "binding_name": "#chatelaine_durability_current",
              "binding_name_override": "#progress_bar_current_amount",
              "binding_condition": "always"
            }
          ]
        }
      },
      {
        "item_lock_cell_image": {
          "type": "image",
          "size": "$cell_size",
          "layer": 9,
          "texture": "textures/ui/cell_image_lock",
          "anchor_from": "center",
          "anchor_to": "center",
          "visible": false,
          "bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name",
              "binding_name": "#chatelaine_item_locked",
              "binding_name_override": "#visible",
              "binding_condition": "always"
            }
          ]
        }
      },
      {
        "lock_in_inventory_overlay": {
          "type": "image",
          "size": "$item_size",
          "offset": "$lock_badge_offset",
          "layer": 23,
          "texture": "textures/ui/item_lock_yellow",
          "anchor_from": "center",
          "anchor_to": "center",
          "visible": false,
          "bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name",
              "binding_name": "#chatelaine_lock_in_inventory",
              "binding_name_override": "#visible",
              "binding_condition": "always"
            }
          ]
        }
      },
      {
        "lock_in_slot_overlay": {
          "type": "image",
          "size": "$item_size",
          "offset": "$lock_badge_offset",
          "layer": 24,
          "texture": "textures/ui/item_lock_red",
          "anchor_from": "center",
          "anchor_to": "center",
          "visible": false,
          "bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name",
              "binding_name": "#chatelaine_lock_in_slot",
              "binding_name_override": "#visible",
              "binding_condition": "always"
            }
          ]
        }
      },
      {
        "selected_marker": {
          "type": "image",
          "size": "$selection_size",
          "layer": 19,
          "texture": "$selection_texture",
          "anchor_from": "center",
          "anchor_to": "center",
          "visible": false,
          "bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name",
              "binding_name": "#chatelaine_selected",
              "binding_name_override": "#visible",
              "binding_condition": "always"
            }
          ]
        }
      },
      {
        "slot_button@chatelaine_inventory.replica_slot_button": {
          "visible": false,
          "$item_collection_name": "$item_collection_name",
          "$primary_button_name": "$primary_button_name",
          "$secondary_button_name": "$secondary_button_name",
          "$quick_button_name": "$quick_button_name",
          "$hover_texture": "$hover_texture"
        }
      }
    ]
  },

  "classic_bag_slot@chatelaine_inventory.replica_slot": {
    "$item_collection_name": "chatelaine_inventory_bag",
    "$primary_button_name": "#chatelaine_inventory_bag_primary",
    "$secondary_button_name": "#chatelaine_inventory_bag_secondary",
    "$quick_button_name": "#chatelaine_inventory_bag_quick"
  },
  "classic_hotbar_slot@chatelaine_inventory.replica_slot": {
    "$item_collection_name": "chatelaine_inventory_hotbar",
    "$primary_button_name": "#chatelaine_inventory_hotbar_primary",
    "$secondary_button_name": "#chatelaine_inventory_hotbar_secondary",
    "$quick_button_name": "#chatelaine_inventory_hotbar_quick"
  },
  "pocket_bag_slot@chatelaine_inventory.replica_slot": {
    "$cell_size": [28, 28],
    "$item_size": [24, 24],
    "$durability_size": [18, 1],
    "$durability_offset": [0, 8],
    "$hover_texture": "textures/ui/slot_disabled_hover_pocket",
    "$selection_texture": "textures/ui/pocket_ui_highlight_selected_slot",
    "$selection_size": ["100% + 4px", "100% + 4px"],
    "$lock_badge_offset": [-1, -1],
    "$item_collection_name": "chatelaine_inventory_bag",
    "$primary_button_name": "#chatelaine_inventory_bag_primary",
    "$secondary_button_name": "#chatelaine_inventory_bag_secondary",
    "$quick_button_name": "#chatelaine_inventory_bag_quick"
  },
  "static_pocket_bag_slot_button": {
    "type": "button",
    "size": ["100%", "100%"],
    "layer": 3,
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "focus_enabled": true,
    "focus_magnet_enabled": true,
    "is_handle_button_move_event": true,
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "#chatelaine_inventory_bag_primary",
        "mapping_type": "pressed",
        "consume_event": true
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "#chatelaine_inventory_bag_primary",
        "mapping_type": "pressed",
        "consume_event": true
      },
      {
        "from_button_id": "button.menu_secondary_select",
        "to_button_id": "#chatelaine_inventory_bag_secondary",
        "mapping_type": "pressed",
        "consume_event": true
      },
      {
        "from_button_id": "button.menu_auto_place",
        "to_button_id": "#chatelaine_inventory_bag_quick",
        "mapping_type": "pressed",
        "consume_event": true
      }
    ],
    "controls": [
      { "default": { "type": "panel", "size": ["100%", "100%"] } },
      {
        "hover": {
          "type": "panel",
          "size": ["100%", "100%"],
          "controls": [
            {
              "hover_image": {
                "type": "image",
                "size": ["100%", "100%"],
                "texture": "textures/ui/slot_disabled_hover_pocket",
                "layer": 4,
                "alpha": 0.8,
                "visible": false,
                "bindings": [
                  {
                    "binding_name": "(not #using_touch)",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            },
            {
              "hover_text@common.hover_text": {
                "layer": 80,
                "visible": false,
                "$hover_text_max_width": 0,
                "property_bag": { "#hover_text": "" },
                "bindings": [
                  {
                    "binding_name": "(not #using_touch)",
                    "binding_name_override": "#visible"
                  },
                  {
                    "binding_name": "#hover_text"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "pressed": {
          "type": "image",
          "size": ["100%", "100%"],
          "texture": "textures/ui/slot_disabled_hover_pocket"
        }
      }
    ]
